def blobStorageResourceGroup = "opal-aso-dev-rg"
def blobStorageAccountNamePrefix = "opalfilebaisapr"
def blobStorageSftpUsers = [
        [container_name: "bteckoh-report", user_name: "bteckohreport"],
        [container_name: "caps-report", user_name: "capsreport"]
]
def devValuesFile = "charts/opal-file-handler-service/values.dev.template.yaml"
def stgValuesFile = "charts/opal-file-handler-service/values.stg.template.yaml"
def functionalTestDatabaseSetupScript = 'src/functionalTest/resources/db/interface-file-content/setup.sql'
def functionalTestDatabaseCleanupScript = 'src/functionalTest/resources/db/interface-file-content/cleanup.sql'

def setupAzure(String storageAccountNamePrefix, String storageResourceGroup, List<Map<String, String>> storageSftpUsers) {
    // Keep the orchestration in Groovy and use shell only for az CLI calls.
    String storageAccount = "${storageAccountNamePrefix}${env.CHANGE_ID}"
    String resourceGroup = storageResourceGroup
    String sshPublicKey = env.BAIS_EMULATOR_PUBLIC_KEY?.trim()

    if (!sshPublicKey) {
        throw new RuntimeException('BAIS_EMULATOR_PUBLIC_KEY must be set')
    }

    for (Map<String, String> mapping : storageSftpUsers) {
        String container = mapping.container_name
        String localUser = mapping.user_name

        if (!container || !localUser) {
            throw new RuntimeException("Each blobStorageSftpUsers entry must include container_name and user_name: ${mapping}")
        }
        //Force Dev subscription login to ensure az cli commands are executed in the correct subscription context
        withSubscriptionLogin('dev') {
            Closure az = { cmd -> return sh(script: "env AZURE_CONFIG_DIR=/opt/jenkins/.azure-stg az $cmd", returnStdout: true).trim() }
            def status
            try {
                status = az "storage account local-user show --account-name '${storageAccount}' --resource-group '${resourceGroup}' --user-name '${localUser}' --only-show-errors --query name --output tsv"
            } catch (e) {
                steps.echo "Create Account error ${e}"
            }

            if (!status) {
                steps.echo "Create Account ${localUser} for ${container} in ${storageAccount}"
                az "storage account local-user create --account-name '${storageAccount}' --resource-group '${resourceGroup}' --user-name '${localUser}'  --home-directory '${container}' --permission-scope permissions=rwdl service=blob resource-name='${container}' --has-ssh-key true --ssh-authorized-key key='${sshPublicKey}' --has-ssh-password false --only-show-errors"
            }
        }
    }
}

def configureFunctionalTestBlobStorage(String valuesFile) {
    Map devValues = steps.readYaml(file: valuesFile)
    Map blobStorage = devValues.blobstorage as Map
    String changeId = env.CHANGE_ID?.trim()

    if (!changeId) {
        throw new RuntimeException('CHANGE_ID must be set to configure the functional-test blob storage')
    }
    if (!blobStorage?.enabled) {
        throw new RuntimeException("Blob storage must be enabled in ${valuesFile}")
    }

    String storageAccount = blobStorage.azureName?.toString()?.replace('${CHANGE_ID}', changeId)
    String resourceGroup = blobStorage.resourceGroup?.toString()?.trim()
    List containers = (blobStorage.setup as Map)?.containers as List
    String container = containers?.find { it == 'bteckoh-report' }

    if (!storageAccount || !resourceGroup || !container) {
        throw new RuntimeException("Missing functional-test blob storage values in ${valuesFile}")
    }

    withSubscriptionLogin('dev') {
        Closure az = { cmd ->
            return sh(
                    script: "env AZURE_CONFIG_DIR=/opt/jenkins/.azure-stg az $cmd",
                    returnStdout: true
            ).trim()
        }
        String endpoint = az(
                "storage account show --name '${storageAccount}' "
                        + "--resource-group '${resourceGroup}' --only-show-errors "
                        + "--query primaryEndpoints.blob --output tsv"
        )
        String accountKey = az(
                "storage account keys list --account-name '${storageAccount}' "
                        + "--resource-group '${resourceGroup}' --only-show-errors "
                        + "--query '[0].value' --output tsv"
        )

        if (!endpoint || !accountKey) {
            throw new RuntimeException("Could not resolve functional-test blob storage account ${storageAccount}")
        }

        env.FILE_STORE_STORAGE_ACCOUNT_NAME = storageAccount
        env.FILE_STORE_STORAGE_URL = endpoint
        env.FILE_STORE_STORAGE_KEY = accountKey
        env.FUNCTIONAL_TEST_BLOB_CONTAINER_NAME = container
    }

    steps.echo "Configured functional-test blob storage account ${storageAccount}, container ${container}"
}

def configureFunctionalTestUserService(String valuesFile) {
    Map devValues = steps.readYaml(file: valuesFile)
    Map javaValues = devValues.java as Map
    Map javaEnvironment = javaValues.environment as Map
    String configuredUrl = javaEnvironment.OPAL_USER_SERVICE_API_URL?.toString()?.trim()
    String userServiceUrl = configuredUrl?.replaceAll('/+$', '')

    if (!userServiceUrl) {
        throw new RuntimeException("Missing OPAL_USER_SERVICE_API_URL in ${valuesFile}")
    }

    env.OPAL_USER_SERVICE_API_URL = userServiceUrl
    steps.echo "Configured functional-test user service ${userServiceUrl}"
}

def configureStagingFunctionalTestEnvironment(String valuesFile) {
    Map stgValues = steps.readYaml(file: valuesFile)
    Map functionalTestValues = stgValues.functionalTest as Map
    Map blobValues = functionalTestValues?.blob as Map
    String containerName = blobValues?.containerName?.toString()?.trim()

    if (!containerName) {
        throw new RuntimeException("Missing functional-test blob container in ${valuesFile}")
    }

    List<String> missingVariables = []
    if (!env.OPAL_FILE_HANDLER_DB_HOST?.trim()) {
        missingVariables.add('OPAL_FILE_HANDLER_DB_HOST')
    }
    if (!env.OPAL_FILE_HANDLER_DB_PORT?.trim()) {
        missingVariables.add('OPAL_FILE_HANDLER_DB_PORT')
    }
    if (!env.OPAL_FILE_HANDLER_DB_NAME?.trim()) {
        missingVariables.add('OPAL_FILE_HANDLER_DB_NAME')
    }
    if (!env.OPAL_FILE_HANDLER_DB_USERNAME?.trim()) {
        missingVariables.add('OPAL_FILE_HANDLER_DB_USERNAME')
    }
    if (!env.OPAL_FILE_HANDLER_DB_PASSWORD?.trim()) {
        missingVariables.add('OPAL_FILE_HANDLER_DB_PASSWORD')
    }
    if (!env.FILE_STORE_STORAGE_ACCOUNT_NAME?.trim()) {
        missingVariables.add('FILE_STORE_STORAGE_ACCOUNT_NAME')
    }
    if (!env.FILE_STORE_STORAGE_URL?.trim()) {
        missingVariables.add('FILE_STORE_STORAGE_URL')
    }
    if (!env.FILE_STORE_STORAGE_KEY?.trim()) {
        missingVariables.add('FILE_STORE_STORAGE_KEY')
    }

    if (!missingVariables.isEmpty()) {
        throw new RuntimeException(
                "Missing staging functional-test secrets: ${missingVariables.join(', ')}"
        )
    }

    configureFunctionalTestUserService(valuesFile)
    env.FUNCTIONAL_TEST_BLOB_CONTAINER_NAME = containerName
    env.FUNCTIONAL_TEST_DB_MANAGED_BY_PIPELINE = 'false'
    steps.echo "Configured staging functional-test database and blob container ${containerName}"
}

def configureFunctionalTestDatabase(String valuesFile, String releaseName, String namespace) {
    Map devValues = steps.readYaml(file: valuesFile)
    Map globalValues = devValues.global as Map
    Map javaValues = devValues.java as Map
    Map javaEnvironment = javaValues.environment as Map
    Map postgresql = javaValues.postgresql as Map

    if (!postgresql?.enabled) {
        throw new RuntimeException("PostgreSQL must be enabled in ${valuesFile}")
    }

    String databaseHost = javaEnvironment.OPAL_FILE_HANDLER_DB_HOST
            ?.toString()
            ?.replace('{{ .Release.Name }}', releaseName)
    String databaseName = globalValues.postgresDatabase?.toString()?.trim()
    String databaseUsername = globalValues.postgresUsername?.toString()?.trim()
    String databasePassword = globalValues.postgresPassword?.toString()
    String databaseOptions = globalValues.postgresOptions?.toString() ?: ''

    if (!databaseHost || databaseHost.contains('{{') || !databaseName
            || !databaseUsername || !databasePassword) {
        throw new RuntimeException("Missing functional-test database values in ${valuesFile}")
    }

    env.OPAL_FILE_HANDLER_DB_HOST = "${databaseHost}.${namespace}.svc.cluster.local"
    env.OPAL_FILE_HANDLER_DB_PORT = '5432'
    env.OPAL_FILE_HANDLER_DB_NAME = databaseName
    env.OPAL_FILE_HANDLER_DB_USERNAME = databaseUsername
    env.OPAL_FILE_HANDLER_DB_PASSWORD = databasePassword
    env.OPAL_FILE_HANDLER_DB_OPTIONS = databaseOptions

    steps.echo "Configured functional-test database ${databaseName} on ${env.OPAL_FILE_HANDLER_DB_HOST}"
}

def executeFunctionalTestDatabaseScript(
        String releaseName,
        String namespace,
        String scriptPath
) {
    String databasePod = "${releaseName}-postgresql-0"

    if (!steps.fileExists(scriptPath)) {
        throw new RuntimeException("Functional-test database script does not exist: ${scriptPath}")
    }

    steps.echo "Executing ${scriptPath} in database pod ${databasePod}"
    steps.sh """
      set -eu
      kubectl --namespace '${namespace}' wait --for=condition=Ready \
        'pod/${databasePod}' --timeout=120s

      set +x
      kubectl --namespace '${namespace}' exec --stdin 'pod/${databasePod}' -- \
        env PGPASSWORD="\$OPAL_FILE_HANDLER_DB_PASSWORD" \
        psql --set=ON_ERROR_STOP=1 \
          --host=127.0.0.1 \
          --port="\$OPAL_FILE_HANDLER_DB_PORT" \
          --username="\$OPAL_FILE_HANDLER_DB_USERNAME" \
          --dbname="\$OPAL_FILE_HANDLER_DB_NAME" \
          --file=- < '${scriptPath}'
    """
}

def secrets = [
        'opal-${env}': [
                secret('bais-emulator-public-key', 'BAIS_EMULATOR_PUBLIC_KEY')
        ]
]

def stagingFunctionalTestSecrets = [
        'opal-${env}': [
                secret('file-handler-service-POSTGRES-HOST', 'OPAL_FILE_HANDLER_DB_HOST'),
                secret('file-handler-service-POSTGRES-PORT', 'OPAL_FILE_HANDLER_DB_PORT'),
                secret('file-handler-service-POSTGRES-DATABASE', 'OPAL_FILE_HANDLER_DB_NAME'),
                secret('file-handler-service-POSTGRES-USER', 'OPAL_FILE_HANDLER_DB_USERNAME'),
                secret('file-handler-service-POSTGRES-PASS', 'OPAL_FILE_HANDLER_DB_PASSWORD'),
                secret(
                        'opal-file-handler-service-file-store-account-name',
                        'FILE_STORE_STORAGE_ACCOUNT_NAME'
                ),
                secret(
                        'opal-file-handler-service-file-store-blob-endpoint',
                        'FILE_STORE_STORAGE_URL'
                ),
                secret(
                        'opal-file-handler-service-file-store-access-key',
                        'FILE_STORE_STORAGE_KEY'
                )
        ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
    [$class     : 'AzureKeyVaultSecret',
     secretType : 'Secret',
     name       : secretName,
     version    : '',
     envVariable: envVar
    ]
}

withPipeline(type, product, component) {
    enableDbMigration(product)
    onPR {
        loadVaultSecrets(secrets)
    }
    onMaster {
        loadVaultSecrets(stagingFunctionalTestSecrets)
    }
    before('akschartsinstall') {
        onPR {
            env.TEST_URL = "https://opal-file-handler-service-pr-${env.CHANGE_ID}.dev.platform.hmcts.net"
        }
        onMaster {
            env.TEST_URL = "https://opal-file-handler-service-staging.staging.platform.hmcts.net"
        }
    }

    afterSuccess('akschartsinstall') {
        onPR {
            String releaseName = "opal-${component}-pr-${env.CHANGE_ID}"
            setupAzure(blobStorageAccountNamePrefix, blobStorageResourceGroup, blobStorageSftpUsers)
            configureFunctionalTestBlobStorage(devValuesFile)
            configureFunctionalTestUserService(devValuesFile)
            configureFunctionalTestDatabase(
                    devValuesFile,
                    releaseName,
                    product
            )
            executeFunctionalTestDatabaseScript(
                    releaseName,
                    product,
                    functionalTestDatabaseSetupScript
            )
            env.FUNCTIONAL_TEST_DB_MANAGED_BY_PIPELINE = 'true'
        }
    }

    afterAlways('test') {
        publishIntegrationResults()
    }

    afterAlways('functionalTest:dev') {
        try {
            onPR {
                withAksClient('dev', 'dev', product) {
                    def kubectl = new Kubectl(this, 'dev', product)
                    kubectl.login()
                    executeFunctionalTestDatabaseScript(
                            "opal-${component}-pr-${env.CHANGE_ID}",
                            product,
                            functionalTestDatabaseCleanupScript
                    )
                }
            }
        } finally {
            publishFunctionalResults()
        }
    }

    afterAlways('smoketest:dev') {
        publishSmokeResults()
    }

    before('functionalTest:stg') {
        onMaster {
            configureStagingFunctionalTestEnvironment(stgValuesFile)
        }
    }

    afterAlways('functionalTest:stg') {
        publishFunctionalResults()
    }

    afterAlways('smoketest:stg') {
        publishSmokeResults()
    }
}
