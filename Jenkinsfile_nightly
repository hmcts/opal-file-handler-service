#!groovy

properties([
  pipelineTriggers([cron('H 07 * * 1-5')]),
  parameters([
    booleanParam(name: 'Integration', defaultValue: true, description: 'Run integration tests'),
    booleanParam(name: 'Functional', defaultValue: true, description: 'Run functional tests'),
    booleanParam(name: 'Smoke', defaultValue: true, description: 'Run smoke tests'),
    booleanParam(name: 'ZephyrExecution', defaultValue: false, description: 'Create Zephyr Execution'),
  ])
])

import uk.gov.hmcts.contino.GradleBuilder

import java.time.DayOfWeek
import java.time.ZonedDateTime

@Library("Infrastructure")

def type = "java"
def product = "opal"
def component = "file-handler-service"

GradleBuilder builder = new GradleBuilder(this, product)

def stagingValuesFile = 'charts/opal-file-handler-service/values.stg.template.yaml'
def stagingEnvironment = [
  name                : 'staging',
  testUrl             : 'https://opal-file-handler-service-staging.staging.platform.hmcts.net',
  userServiceApiUrl   : 'https://opal-user-service.staging.platform.hmcts.net',
  loggingServiceApiUrl: 'https://opal-logging-service.staging.platform.hmcts.net',
]

def secrets = [
  'opal-${env}': [
    secret('jiraAuthToken', 'JIRA_AUTH_TOKEN'),
    secret('file-handler-service-POSTGRES-HOST', 'OPAL_FILE_HANDLER_DB_HOST'),
    secret('file-handler-service-POSTGRES-PORT', 'OPAL_FILE_HANDLER_DB_PORT'),
    secret('file-handler-service-POSTGRES-DATABASE', 'OPAL_FILE_HANDLER_DB_NAME'),
    secret('file-handler-service-POSTGRES-USER', 'OPAL_FILE_HANDLER_DB_USERNAME'),
    secret('file-handler-service-POSTGRES-PASS', 'OPAL_FILE_HANDLER_DB_PASSWORD'),
    secret('opal-file-handler-service-file-store-account-name', 'FILE_STORE_STORAGE_ACCOUNT_NAME'),
    secret('opal-file-handler-service-file-store-blob-endpoint', 'FILE_STORE_STORAGE_URL'),
    secret('opal-file-handler-service-file-store-access-key', 'FILE_STORE_STORAGE_KEY'),
  ],
]

def stageFailures = []

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   version    : '',
   envVariable: envVar
  ]
}

def configureTestEnvironment = { testEnvironment ->
  env.ENVIRONMENT_NAME = testEnvironment.name
  env.TEST_URL = testEnvironment.testUrl
  env.OPAL_USER_SERVICE_API_URL = testEnvironment.userServiceApiUrl
  env.OPAL_LOGGING_SERVICE_API_URL = testEnvironment.loggingServiceApiUrl

  echo "Configured ${testEnvironment.name} test environment: TEST_URL=${env.TEST_URL}"
}

def configureFunctionalTestEnvironment = { valuesFile ->
  Map stagingValues = steps.readYaml(file: valuesFile)
  Map functionalTestValues = stagingValues.functionalTest as Map
  Map blobValues = functionalTestValues?.blob as Map
  String containerName = blobValues?.containerName?.toString()?.trim()

  if (!containerName) {
    throw new RuntimeException("Missing functional-test blob container in ${valuesFile}")
  }

  List<String> missingVariables = []
  if (!env.OPAL_FILE_HANDLER_DB_HOST?.trim()) {
    missingVariables.add('OPAL_FILE_HANDLER_DB_HOST')
  }
  if (!env.OPAL_FILE_HANDLER_DB_PORT?.trim()) {
    missingVariables.add('OPAL_FILE_HANDLER_DB_PORT')
  }
  if (!env.OPAL_FILE_HANDLER_DB_NAME?.trim()) {
    missingVariables.add('OPAL_FILE_HANDLER_DB_NAME')
  }
  if (!env.OPAL_FILE_HANDLER_DB_USERNAME?.trim()) {
    missingVariables.add('OPAL_FILE_HANDLER_DB_USERNAME')
  }
  if (!env.OPAL_FILE_HANDLER_DB_PASSWORD?.trim()) {
    missingVariables.add('OPAL_FILE_HANDLER_DB_PASSWORD')
  }
  if (!env.FILE_STORE_STORAGE_ACCOUNT_NAME?.trim()) {
    missingVariables.add('FILE_STORE_STORAGE_ACCOUNT_NAME')
  }
  if (!env.FILE_STORE_STORAGE_URL?.trim()) {
    missingVariables.add('FILE_STORE_STORAGE_URL')
  }
  if (!env.FILE_STORE_STORAGE_KEY?.trim()) {
    missingVariables.add('FILE_STORE_STORAGE_KEY')
  }

  if (!missingVariables.isEmpty()) {
    throw new RuntimeException(
      "Missing staging functional-test secrets: ${missingVariables.join(', ')}"
    )
  }

  env.FUNCTIONAL_TEST_BLOB_CONTAINER_NAME = containerName
  env.FUNCTIONAL_TEST_DB_MANAGED_BY_PIPELINE = 'false'
  echo "Configured staging functional-test database and blob container ${containerName}"
}

def configureZephyrExecution = { testEnvironment ->
  env.EXECUTION_BUILD = env.GIT_COMMIT
  env.EXECUTION_ENVIRONMENT = testEnvironment.name
  env.EXECUTION_CYCLE_DESCRIPTION = "Nightly execution for commit ${env.GIT_COMMIT} on environment ${testEnvironment.name}.\n" +
    "https://sds-build.hmcts.net/job/HMCTS_Nightly/job/opal-file-handler-service/job/master/${env.BUILD_NUMBER}/"
  echo "Zephyr execution will be created with the following details:\n" +
    "Build: ${env.EXECUTION_BUILD}\n" +
    "Environment: ${env.EXECUTION_ENVIRONMENT}\n" +
    "Description: ${env.EXECUTION_CYCLE_DESCRIPTION}"
}

def recordStageFailure = { stageName, reason ->
  def message = "${stageName}: ${reason}"
  stageFailures << message
  steps.echo message
}

def deleteStageOutputs = { List<String> paths ->
  if (paths == null || paths.isEmpty()) {
    return
  }

  def script = paths.collect { "rm -rf '${it}'" }.join('\n')
  steps.sh script
}

def copyReportOutputIfPresent = { targetDirectory, sourceDirectory ->
  steps.sh """
    mkdir -p ${targetDirectory}
    rm -rf ${targetDirectory}/report
    cp -R ${sourceDirectory} ${targetDirectory}/report
  """
}

def ensureReportOutputExists = { reportLabel, targetDirectory, candidateDirectories ->
  for (String candidateDirectory : candidateDirectories) {
    if (steps.fileExists("${candidateDirectory}/index.html")
      || steps.fileExists("${candidateDirectory}/htmlReport/test-summary.html")) {
      copyReportOutputIfPresent(targetDirectory, candidateDirectory)
      return
    }
  }

  throw new RuntimeException(
    "${reportLabel} was not generated in any expected report location: ${candidateDirectories.join(', ')}"
  )
}

def ensureArtifactExists = { artifactLabel, artifactPath ->
  if (!steps.fileExists(artifactPath)) {
    throw new RuntimeException("${artifactLabel} was not generated at ${artifactPath}")
  }
}

def copyJunitResultsIfPresent = { targetDirectory, sourceDirectory ->
  steps.sh """
    mkdir -p ${targetDirectory}/test-results
    rm -rf ${targetDirectory}/test-results/*
    if [ -d "${sourceDirectory}" ]; then
      cp -R ${sourceDirectory}/. ${targetDirectory}/test-results/
    fi
  """
}

def publishFunctionalResults = {
  ensureReportOutputExists(
    'Functional Tests Report',
    'functional-output',
    ['functional-test-report', 'build/reports/tests/functional']
  )
  ensureArtifactExists(
    'Functional Zephyr report',
    'functional-output/zephyr/cucumber-functional.json'
  )
  copyJunitResultsIfPresent('functional-output', 'build/test-results/functional')

  steps.junit allowEmptyResults: true, testResults: 'functional-output/test-results/**/*.xml'
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/**/*'
  publishHTML target: [
    allowMissing         : true,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : 'functional-output/report',
    reportFiles          : 'index.html',
    reportName           : 'Serenity Functional Test Report'
  ]
}

def publishIntegrationResults = {
  ensureReportOutputExists(
    'Integration Tests Report',
    'integration-output',
    ['build/reports/tests/integration']
  )
  ensureArtifactExists(
    'Integration Zephyr report',
    'integration-output/zephyr/Junit5Report-IntegrationTest.json'
  )
  copyJunitResultsIfPresent('integration-output', 'build/test-results/integration')

  steps.junit allowEmptyResults: true, testResults: 'integration-output/test-results/**/*.xml'
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'integration-output/**/*'
  publishHTML target: [
    allowMissing         : true,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : 'integration-output/report',
    reportFiles          : 'index.html',
    reportName           : 'Integration Tests Report'
  ]
}

def publishSmokeResults = {
  ensureReportOutputExists(
    'Smoke Tests Report',
    'smoke-output',
    ['smoke-test-report', 'build/reports/tests/smoke']
  )
  ensureArtifactExists(
    'Smoke Zephyr report',
    'smoke-output/zephyr/cucumber-smoke.json'
  )
  copyJunitResultsIfPresent('smoke-output', 'build/test-results/smoke')

  steps.junit allowEmptyResults: true, testResults: 'smoke-output/test-results/**/*.xml'
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'smoke-output/**/*'
  publishHTML target: [
    allowMissing         : true,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : 'smoke-output/report',
    reportFiles          : 'index.html',
    reportName           : 'Serenity Smoke Test Report'
  ]
}

def runIntegrationZephyrExecution = { stageName ->
  try {
    builder.gradle('createJiraExecutionFromJUnit5ReportIntegrationTest')
  } catch (error) {
    recordStageFailure(stageName, "Zephyr execution failed. Error: ${error.message}")
  }
}

def runFunctionalZephyrExecution = { stageName, stageKey ->
  try {
    builder.gradle("-PzephyrFunctionalStage=${stageKey} createJiraExecutionFromFunctionalReport")
  } catch (error) {
    recordStageFailure(stageName, "Zephyr execution failed. Error: ${error.message}")
  }
}

def runIntegrationStage = { shouldRunWithZephyr ->
  if (!params.Integration) {
    return
  }

  def stageName = 'Integration Tests'

  stage(stageName) {
    deleteStageOutputs([
      'integration-output',
      'build/reports/tests/integration',
      'build/test-results/integration',
      'target/zephyr-reports/Junit5Report-IntegrationTest.json',
    ])

    try {
      builder.gradle('integration')
    } catch (error) {
      recordStageFailure(stageName, "failed. Error: ${error.message}")
    } finally {
      try {
        publishIntegrationResults()
      } catch (publishError) {
        recordStageFailure(stageName, "result publication failed. Error: ${publishError.message}")
      }
      if (shouldRunWithZephyr) {
        runIntegrationZephyrExecution(stageName)
      }
    }
  }
}

def runFunctionalStage = { shouldRunWithZephyr ->
  if (!params.Functional) {
    return
  }

  def stageName = 'Functional Tests'

  stage(stageName) {
    deleteStageOutputs([
      'functional-output',
      'functional-test-report',
      'build/reports/tests/functional',
      'build/test-results/functional',
      'target/cucumber.json',
      'target/site/serenity',
    ])

    try {
      builder.gradle('functional')
    } catch (error) {
      recordStageFailure(stageName, "failed. Error: ${error.message}")
    } finally {
      try {
        builder.gradle('syncFunctionalArtifactsFromExistingResults')
        publishFunctionalResults()
      } catch (publishError) {
        recordStageFailure(stageName, "result publication failed. Error: ${publishError.message}")
      }
      if (shouldRunWithZephyr) {
        runFunctionalZephyrExecution(stageName, 'functional')
      }
    }
  }
}

def runSmokeStage = { shouldRunWithZephyr ->
  if (!params.Smoke) {
    return
  }

  def stageName = 'Smoke Tests'

  stage(stageName) {
    deleteStageOutputs([
      'smoke-output',
      'smoke-test-report',
      'build/reports/tests/smoke',
      'build/test-results/smoke',
      'target/cucumber.json',
      'target/site/serenity',
    ])

    try {
      builder.gradle('smoke')
    } catch (error) {
      recordStageFailure(stageName, "failed. Error: ${error.message}")
    } finally {
      try {
        builder.gradle('syncSmokeArtifactsFromExistingResults')
        publishSmokeResults()
      } catch (publishError) {
        recordStageFailure(stageName, "result publication failed. Error: ${publishError.message}")
      }
      if (shouldRunWithZephyr) {
        runFunctionalZephyrExecution(stageName, 'smoke')
      }
    }
  }
}

withNightlyPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  configureTestEnvironment(stagingEnvironment)

  onMaster {
    enableSlackNotifications('#opal-nightly-builds')
  }

  afterAlways('DependencyCheckNightly') {
    if (params.Functional) {
      configureFunctionalTestEnvironment(stagingValuesFile)
    }

    echo 'Integration:' + params.Integration
    echo 'Functional:' + params.Functional
    echo 'Smoke:' + params.Smoke
    echo 'ZephyrExecution:' + params.ZephyrExecution

    def today = ZonedDateTime.now().getDayOfWeek()
    def shouldRunWithZephyr = params.ZephyrExecution || today == DayOfWeek.FRIDAY
    echo 'Resolved Zephyr execution:' + shouldRunWithZephyr

    if (shouldRunWithZephyr) {
      configureZephyrExecution(stagingEnvironment)
    }

    runIntegrationStage(shouldRunWithZephyr)
    runFunctionalStage(shouldRunWithZephyr)
    runSmokeStage(shouldRunWithZephyr)

    if (!stageFailures.isEmpty()) {
      currentBuild.result = 'FAILURE'
      error("One or more selected test stages failed:\n - ${stageFailures.join('\n - ')}")
    }
  }
}
