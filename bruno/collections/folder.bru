meta {
  name: Get Interface File
  seq: 1
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{BEARER_TOKEN}}
}

script:pre-request {
  function getTokenExpiresAt(token) {
    try {
      const encodedPayload = token.split(".")[1];
      const base64Payload = encodedPayload.replace(/-/g, "+").replace(/_/g, "/")
        .padEnd(Math.ceil(encodedPayload.length / 4) * 4, "=");
      const payload = JSON.parse(atob(base64Payload));

      return typeof payload.exp === "number" ? payload.exp * 1000 : null;
    } catch {
      return null;
    }
  }

  const refreshBufferMs = 60 * 1000;
  const token = bru.getVar("BEARER_TOKEN") || bru.getEnvVar("BEARER_TOKEN");
  const tokenExpiresAtValue = bru.getVar("tokenExpiresAt");
  const hasTokenExpiry = tokenExpiresAtValue != null && String(tokenExpiresAtValue).trim() !== "";
  const tokenExpiresAt = hasTokenExpiry ? Number(tokenExpiresAtValue) : null;
  const tokenNeedsRefresh = !token || (hasTokenExpiry
    && (!Number.isFinite(tokenExpiresAt) || Date.now() >= tokenExpiresAt - refreshBufferMs));

  if (!tokenNeedsRefresh) {
    return;
  }

  const response = await bru.sendRequest({
    method: "GET",
    url: `${bru.getEnvVar("userURL")}/testing-support/token/user`,
    headers: {
      "X-User-Email": bru.getEnvVar("userEmail")
    }
  });

  if (response.status !== 200) {
    throw new Error(`Could not obtain bearer token: HTTP ${response.status}`);
  }

  const responsePayload = response.data ?? response.body;
  const body = typeof responsePayload === "string" ? JSON.parse(responsePayload) : responsePayload;
  if (!body?.access_token) {
    throw new Error("Could not obtain bearer token: access_token was not returned");
  }

  const expiry = getTokenExpiresAt(body.access_token) ?? Date.now() + (20 * 60 * 1000);
  bru.setVar("BEARER_TOKEN", body.access_token);
  bru.setVar("tokenExpiresAt", String(expiry));
}
