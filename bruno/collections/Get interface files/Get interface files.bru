meta {
  name: Get interface files - filters
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/interface-files?business_unit_code={{businessUnitCode}}&type={{interfaceFileTypes}}&not_status={{excludedStatuses}}&not_target={{excludedTarget}}
  body: none
  auth: inherit
}

tests {
  test("returns filtered interface files", function() {
    expect(res.status).to.equal(200);
    expect(res.body.number_of_results).to.be.greaterThan(0);
    expect(res.body.interface_files).to.be.an("array");

    const allowedTypes = bru.getEnvVar("interfaceFileTypes").split(",");
    const excludedStatuses = bru.getEnvVar("excludedStatuses").split(",");
    const excludedTarget = bru.getEnvVar("excludedTarget");
    const businessUnitCode = bru.getEnvVar("businessUnitCode");

    res.body.interface_files.forEach((interfaceFile) => {
      expect(allowedTypes).to.include(interfaceFile.type);
      expect(excludedStatuses).to.not.include(interfaceFile.status);
      expect(interfaceFile.target).to.not.equal(excludedTarget);
      expect(interfaceFile.business_unit_codes).to.include(businessUnitCode);
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

