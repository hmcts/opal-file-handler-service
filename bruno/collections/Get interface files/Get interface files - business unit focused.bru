meta {
  name: Business unit filter
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/interface-files?business_unit_code={{businessUnitCode}}
  body: none
  auth: inherit
}

tests {
  test("returns files for the requested business unit", function() {
    expect(res.status).to.equal(200);
    expect(res.body.interface_files).to.be.an("array");
    expect(res.body.number_of_results).to.be.greaterThan(0);

    const code = bru.getEnvVar("businessUnitCode");
    res.body.interface_files.forEach((file) => {
      expect(file.business_unit_codes).to.include(code);
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

