meta {
  name: Add interface file - system user
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/interface-files
  body: multipartForm
  auth: bearer
}

script:pre-request {
  const clientId = bru.getEnvVar("systemClientId");
  const clientSecret = bru.getEnvVar("systemClientSecret");
  const tenantId = bru.getEnvVar("tenantId");

  if (!clientId || !clientSecret || !tenantId) {
    throw new Error("Set tenantId, systemClientId and systemClientSecret in the local Bruno environment");
  }

  const response = await bru.sendRequest({
    method: "POST",
    url: `https://login.microsoftonline.com/${tenantId}/oauth2/v2.0/token`,
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    data: [
      ["grant_type", "client_credentials"],
      ["client_id", clientId],
      ["client_secret", clientSecret],
      ["scope", `api://${clientId}/.default`]
    ].map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`).join("&")
  });

  if (response.status !== 200) throw new Error(`Could not obtain system-user token: HTTP ${response.status}`);
  const payload = response.data ?? response.body;
  const body = typeof payload === "string" ? JSON.parse(payload) : payload;
  if (!body?.access_token) throw new Error("System-user token was not returned");
  bru.setVar("BEARER_TOKEN", body.access_token);
}

auth:bearer {
  token: {{BEARER_TOKEN}}
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(/tmp/po-8746-system-user-upload.xlsx) @contentType(application/octet-stream)
  metadata: {"source":"BTECKOH_REPORT","target":"OPAL","type":"SOURCE","domain":"FINES","payment_type":"CASH","file_name":"po-8746-system-user-upload.xlsx","should_pre_process_file":false} @contentType(application/json)
}

tests {
  test("creates an interface file for the system user", function() {
    expect(res.status).to.equal(201);
    expect(res.body.interface_file_id).to.be.a("number");
    expect(res.body.status).to.equal("INGESTED");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
